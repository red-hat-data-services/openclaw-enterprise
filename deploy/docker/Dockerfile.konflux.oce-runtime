ARG BASE_IMAGE=registry.access.redhat.com/hi/nodejs:24@sha256:894f30fa12a8992a39ad4241fd353fec4ec71d223d398aeb1deb3dc3f06abbc0
ARG BUILDER_IMAGE=registry.access.redhat.com/hi/nodejs:24-builder@sha256:df03f3031d7bf9f9bbce2cd1f9c0eea2e7eba23b66aaa22c457db3c770d6af74

# OpenClaw Enterprise (OCE) runtime image on Hummingbird.
#
# Konflux port of deploy/runtime/Dockerfile. Non-hermetic: it follows that
# recipe stage by stage, swapping Debian node:24 for the Hummingbird Node.js 24
# runtime and builder streams. OCE ignores the image entrypoint and runs tini
# plus its own generated Node.js program, so the image must reproduce OCE's
# implicit layout
# (/app, /home/node, /usr/bin/tini, /usr/local/bin/node, /usr/local/bin/gh).
# The OpenClaw build runs dependency lifecycle scripts unrestricted, as
# upstream does; this is not compatible with Konflux hermetic builds yet.

FROM ${BUILDER_IMAGE} AS builder
USER 0
# OCE's Dockerfile asserts the Node series its recipe was ported for.
RUN node -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); if (major !== 24 || minor < 22 || (minor === 22 && patch < 1)) throw new Error(`Select a Node.js 24.22.1+ base image in the 24 series; found ${process.version}.`);'
ARG TARGETARCH
ARG PNPM_OCE_VERSION
ARG PNPM_OCE_SHA512
ARG PNPM_OPENCLAW_VERSION
ARG PNPM_OPENCLAW_SHA512
ARG PNPM_OPENCLAW_EXE_SHA256_AMD64
ARG PNPM_OPENCLAW_EXE_SHA256_ARM64
RUN dnf install -y --setopt=install_weak_deps=False --setopt=tsflags=nodocs \
        git-core gcc-c++ make cmake python3 tar gzip findutils diffutils \
    && dnf clean all
# Hummingbird ships neither corepack nor pnpm. Install the exact releases that
# the OCE and OpenClaw packageManager fields select, verified with the same
# SHA-512 that corepack would check. pnpm 12 delegates to a native binary,
# which is verified per architecture and placed where its install script puts it.
RUN /bin/bash -euo pipefail <<'EOF'
case "${TARGETARCH}" in
    amd64) exe_arch=x64 exe_sha256=${PNPM_OPENCLAW_EXE_SHA256_AMD64} ;;
    arm64) exe_arch=arm64 exe_sha256=${PNPM_OPENCLAW_EXE_SHA256_ARM64} ;;
    *)
        echo "unsupported architecture: ${TARGETARCH}" >&2
        exit 1
        ;;
esac
cd /tmp
curl -fsSLO "https://registry.npmjs.org/pnpm/-/pnpm-${PNPM_OCE_VERSION}.tgz"
echo "${PNPM_OCE_SHA512}  pnpm-${PNPM_OCE_VERSION}.tgz" | sha512sum --check --strict
mkdir -p /opt/pnpm-oce/.bin
tar -xzf "pnpm-${PNPM_OCE_VERSION}.tgz" -C /opt/pnpm-oce --strip-components=1
chmod 0755 /opt/pnpm-oce/bin/pnpm.mjs
ln -s ../bin/pnpm.mjs /opt/pnpm-oce/.bin/pnpm

curl -fsSLO "https://registry.npmjs.org/pnpm/-/pnpm-${PNPM_OPENCLAW_VERSION}.tgz"
echo "${PNPM_OPENCLAW_SHA512}  pnpm-${PNPM_OPENCLAW_VERSION}.tgz" | sha512sum --check --strict
curl -fsSLO "https://registry.npmjs.org/@pnpm/exe.linux-${exe_arch}/-/exe.linux-${exe_arch}-${PNPM_OPENCLAW_VERSION}.tgz"
echo "${exe_sha256}  exe.linux-${exe_arch}-${PNPM_OPENCLAW_VERSION}.tgz" | sha256sum --check --strict
mkdir -p /opt/pnpm-openclaw/.bin /tmp/pnpm-exe
tar -xzf "pnpm-${PNPM_OPENCLAW_VERSION}.tgz" -C /opt/pnpm-openclaw --strip-components=1
tar -xzf "exe.linux-${exe_arch}-${PNPM_OPENCLAW_VERSION}.tgz" -C /tmp/pnpm-exe --strip-components=1
install -m 0755 /tmp/pnpm-exe/pnpm /opt/pnpm-openclaw/pnpm
ln -s ../pnpm /opt/pnpm-openclaw/.bin/pnpm
rm -rf /tmp/pnpm-* /tmp/exe.linux-*

PATH=/opt/pnpm-oce/.bin:$PATH pnpm --version | grep -qx "${PNPM_OCE_VERSION}"
PATH=/opt/pnpm-openclaw/.bin:$PATH pnpm --version | grep -qx "${PNPM_OPENCLAW_VERSION}"
EOF

# tini is not packaged for Hummingbird; OCE starts every runtime container
# through /usr/bin/tini, so build the same release Debian ships from source.
FROM builder AS tini-build
ARG TINI_VERSION
ARG TINI_SOURCE_SHA256
WORKDIR /build
RUN /bin/bash -euo pipefail <<'EOF'
curl -fsSL "https://github.com/krallin/tini/archive/refs/tags/v${TINI_VERSION}.tar.gz" -o tini.tar.gz
echo "${TINI_SOURCE_SHA256}  tini.tar.gz" | sha256sum --check --strict
tar -xzf tini.tar.gz --strip-components=1
# tini's CMakeLists predates CMake 4's minimum policy version.
cmake -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE=Release .
make tini
./tini --version | grep -q "tini version ${TINI_VERSION}"
install -D -m 0755 tini /out/usr/bin/tini
EOF

FROM builder AS gh-download
ARG TARGETARCH
ARG GH_VERSION
ARG GH_CHECKSUMS_SHA256
WORKDIR /build
# Upstream hardens the toolchain by pinning the release checksums file itself
# and verifying the archive against the matching line, instead of the archive
# alone.
RUN /bin/bash -euo pipefail <<'EOF'
case "${TARGETARCH}" in
    amd64 | arm64) ;;
    *)
        echo "unsupported architecture: ${TARGETARCH}" >&2
        exit 1
        ;;
esac
archive="gh_${GH_VERSION}_linux_${TARGETARCH}.tar.gz"
curl -fsSLO --retry 6 "https://github.com/cli/cli/releases/download/v${GH_VERSION}/${archive}"
curl -fsSLO --retry 6 "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_checksums.txt"
echo "${GH_CHECKSUMS_SHA256}  gh_${GH_VERSION}_checksums.txt" | sha256sum --check --strict
grep " ${archive}$" "gh_${GH_VERSION}_checksums.txt" | sha256sum --check --strict
tar -xzf "${archive}" --strip-components=1
install -D -m 0755 bin/gh /out/usr/local/bin/gh
/out/usr/local/bin/gh --version | grep -q "^gh version ${GH_VERSION} "
EOF

# The build context is this repository; .dockerignore keeps local state,
# archived prior art and test trees out of it.
FROM builder AS oce-source
WORKDIR /oce
COPY . .

# Upstream runtime stage: the managed Google CLI, installed by upstream's
# installer from the reviewed release manifest next to the OCE skill. Upstream
# runs it in the final stage; here it runs in the builder, which has curl and
# tar, and the final stage copies the tree.
FROM oce-source AS google-cli
ARG TARGETARCH
RUN /bin/bash -euo pipefail <<'EOF'
plugin=/out/usr/local/lib/oce/plugins/google
mkdir -p "$plugin/bin"
cp -R apps/controller/plugins/oce-google-workspace/skills "$plugin/skills"
cp apps/controller/plugins/oce-google-workspace/ai.openclaw.oce/release.json "$plugin/release.json"
node deploy/runtime/google/install-gog.mts "$plugin" "linux-${TARGETARCH}" "$plugin/bin" scripts/ci/download-pinned.sh
EOF

# Repository-credentials client, built from the same OCE checkout. Lifecycle
# scripts stay disabled, as upstream does. Upstream compiles only the client
# closure and assembles it as one tree with fixed modes and timestamps, copied
# onto / as the last layer.
FROM oce-source AS repository-client-build
ENV PATH=/opt/pnpm-oce/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
RUN /bin/bash -euo pipefail <<'EOF'
pnpm install --frozen-lockfile --ignore-scripts --store-dir=/tmp/pnpm-store
rm -rf /tmp/pnpm-store
node_modules/.bin/tsc -p deploy/runtime/repository-credentials/tsconfig.client.json --pretty false
node scripts/build-repository-credentials.mjs --client-only
client=.build/runtime-client/opt/oce/repository-credentials
mkdir -p "$client"
cp -R deploy/runtime/bin "$client/bin"
cp .build/repository-credentials/client/package.json "$client/package.json"
cp -R .build/repository-credentials/client/dist "$client/dist"
chmod 0755 .build/runtime-client/opt .build/runtime-client/opt/oce
chmod -R a+rX "$client"
chmod 0555 "$client/bin/gh" "$client/bin/oce-github"
test -f "$client/dist/drivers/repo/github/credentials/client/router.js"
test -f "$client/dist/drivers/repo/github/credentials/client/native-git.js"
test -f "$client/dist/drivers/repo/github/credentials/client/draft-pr.js"
test -x "$client/dist/drivers/repo/github/credentials/client/hooks/pre-push"
find .build/runtime-client -exec touch -h -d @0 {} +
EOF

FROM builder AS openclaw-source
ARG OPENCLAW_COMMIT
ARG OPENCLAW_SOURCE_SHA256
ARG OPENCLAW_BUILD_TIMESTAMP
ENV GIT_COMMIT=${OPENCLAW_COMMIT}
ENV OPENCLAW_BUILD_TIMESTAMP=${OPENCLAW_BUILD_TIMESTAMP}
ENV OPENCLAW_PREFER_PNPM=1
WORKDIR /source
# Upstream's Dockerfile passes these pins through deploy/runtime/openclaw-source.json;
# the conf plays that role here, so verify it against the checked-out manifest
# the same way scripts/lib/openclaw-source.mjs verify does upstream.
COPY --from=oce-source /oce/deploy/runtime/*.patch /oce/scripts/build-runtime-assets.mjs /oce/deploy/runtime/openclaw-source.json /tmp/oce/
COPY --from=oce-source /oce/scripts/lib/openclaw-source.mjs /tmp/oce/lib/
RUN /bin/bash -euo pipefail <<'EOF'
OPENCLAW_COMMIT="${OPENCLAW_COMMIT}" OPENCLAW_SOURCE_SHA256="${OPENCLAW_SOURCE_SHA256}" \
    OPENCLAW_BUILD_TIMESTAMP="${OPENCLAW_BUILD_TIMESTAMP}" \
    node /tmp/oce/lib/openclaw-source.mjs verify /tmp/oce/openclaw-source.json
curl -fsSL "https://codeload.github.com/openclaw/openclaw/tar.gz/${GIT_COMMIT}" -o /tmp/openclaw-source.tar.gz
echo "${OPENCLAW_SOURCE_SHA256}  /tmp/openclaw-source.tar.gz" | sha256sum --check --strict
tar -xzf /tmp/openclaw-source.tar.gz --strip-components=1
rm /tmp/openclaw-source.tar.gz
# Bridge patches carried by OCE until OpenClaw main includes them, in the
# order of deploy/runtime/Dockerfile.
git apply /tmp/oce/openclaw-codex-read-only-paths.patch
git apply /tmp/oce/openclaw-codex-full-access-profile.patch
git apply --unidiff-zero /tmp/oce/stock-codex-0.163.0-alpha.2-dependency-pin.patch
node /tmp/oce/build-runtime-assets.mjs inputs /source /inputs
EOF

# @matrix-org/matrix-sdk-crypto-nodejs downloads its native library from GitHub
# during install, with no retry or checksum. Fetch the pinned library with OCE's
# retrying, checksum-verifying helper; both installs below get it from a
# loopback server.
FROM oce-source AS matrix-sdk-crypto
ARG TARGETARCH
ARG MATRIX_SDK_CRYPTO_VERSION
ARG MATRIX_SDK_CRYPTO_SHA256_AMD64
ARG MATRIX_SDK_CRYPTO_SHA256_ARM64
RUN /bin/bash -euo pipefail <<'EOF'
case "${TARGETARCH}" in
    amd64) library=matrix-sdk-crypto.linux-x64-gnu.node sha256=${MATRIX_SDK_CRYPTO_SHA256_AMD64} ;;
    arm64) library=matrix-sdk-crypto.linux-arm64-gnu.node sha256=${MATRIX_SDK_CRYPTO_SHA256_ARM64} ;;
    *)
        echo "unsupported architecture: ${TARGETARCH}" >&2
        exit 1
        ;;
esac
mkdir -p "/out/v${MATRIX_SDK_CRYPTO_VERSION}"
bash /oce/scripts/ci/download-pinned.sh \
    "https://github.com/matrix-org/matrix-rust-sdk-crypto-nodejs/releases/download/v${MATRIX_SDK_CRYPTO_VERSION}/${library}" \
    "/out/v${MATRIX_SDK_CRYPTO_VERSION}/${library}" "${sha256}"
EOF

FROM builder AS openclaw-dependency-inputs
ARG OPENCLAW_COMMIT
ARG OPENCLAW_BUILD_TIMESTAMP
ENV GIT_COMMIT=${OPENCLAW_COMMIT}
ENV OPENCLAW_BUILD_TIMESTAMP=${OPENCLAW_BUILD_TIMESTAMP}
ENV OPENCLAW_PREFER_PNPM=1
ENV PATH=/opt/pnpm-openclaw/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WORKDIR /source
COPY --from=openclaw-source /inputs/ ./

FROM openclaw-dependency-inputs AS openclaw-patched-source
# install-attempts.sh bounds each attempt, so one slow download cannot hold the build.
RUN --mount=type=bind,from=matrix-sdk-crypto,source=/out,target=/tmp/matrix-sdk-crypto \
    --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    sh /tmp/oce-runtime/install-attempts.sh \
        node /tmp/oce-runtime/with-pinned-matrix-sdk-crypto.mjs /tmp/matrix-sdk-crypto \
        pnpm install --frozen-lockfile --store-dir=/tmp/pnpm-store \
        --config.supportedArchitectures.os=linux \
        --config.supportedArchitectures.cpu="$(node -p 'process.arch')" \
        --config.supportedArchitectures.libc=glibc \
    && rm -rf /tmp/pnpm-store
COPY --from=openclaw-source /source/ ./
# Exercise the original caller through the public RPC before and after the
# placement acknowledgment, including revocation, against this exact source.
RUN --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    git apply /tmp/oce-runtime/openclaw-required-worker-authority-regression.patch
# Remove this bridge when the pinned Control UI offers a browser navigation after access refusal.
RUN --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    git apply /tmp/oce-runtime/openclaw-control-ui-browser-reconnect.patch
# The runtime needs supervised recovery across private PID namespaces. Native
# lock reinspection and custody still guard every destructive operation.
RUN --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    git apply /tmp/oce-runtime/openclaw-terminated-gateway-namespace.patch
# Forward the scoped Google placeholder and the OpenShell TLS root to native worker children.
RUN --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    git apply /tmp/oce-runtime/openclaw-google-worker-placeholder.patch

# Run the bridge tests alongside the build using the same patched source.
# Packaging mounts this stage so a failed test still blocks the runtime image.
FROM openclaw-patched-source AS openclaw-bridge-tests
# One runner invocation for the Node test files: the runner compiles the whole
# source tree for its workers first (about a minute), and a second invocation on
# a fresh .artifacts mount would compile it again. The test runner restores its
# cache by renaming directories; a fresh mount keeps those renames off the
# previous layer.
RUN --network=none --mount=type=tmpfs,target=/source/.artifacts \
    OPENCLAW_VITEST_RUNTIME=node OPENCLAW_VITEST_MAX_WORKERS=1 pnpm_config_verify_deps_before_run=false \
    node --import ./scripts/tsx.mjs scripts/test-projects.mts src/gateway/server.required-placement-scopes.test.ts \
    src/infra/gateway-lock-recovery.test.ts src/node-host/node-worker-google-placeholder.test.ts
# Type-check the two UI test graphs touched by the bridge. The upstream runner
# generates its database types and compiler cache under .artifacts.
RUN --network=none --mount=type=tmpfs,target=/source/.artifacts \
    node scripts/run-tsgo-core-test-shards.mjs --ci-graphs-json '["core-test-ui-chat","core-test-ui-app"]'
# Select only the Node projects that own these files: the browser project starts a
# Vite server on localhost, which Buildah's network-less RUN cannot resolve.
RUN --network=none cd ui && node ../scripts/run-node-package-bin.mts vitest run --config vitest.config.ts \
    --project unit --project unit-node \
    src/api/gateway-reachability.node.test.ts src/app/gateway-store.observers.test.ts src/app/app-shell-view.test.ts \
    src/app/gateway-page-activation.test.ts

FROM openclaw-patched-source AS openclaw-build
# Rootless Podman and Buildah-in-container builds hide the cgroup memory limit,
# so OpenClaw refuses to pick a tsdown heap. Name it explicitly; a full build
# needs at least 4352MB and peaks near 4.7GB.
# OpenClaw's own Dockerfile maps this build argument onto OPENCLAW_TSDOWN_MAX_OLD_SPACE_MB.
ARG OPENCLAW_DOCKER_BUILD_TSDOWN_MAX_OLD_SPACE_MB
# Follow the pinned upstream Docker assembly; plugin-local dependencies remain
# separate when a plugin and core require different versions.
RUN OPENCLAW_INTERNAL_DOCKER_BUILD_PLUGIN_IDS=codex,slack \
    OPENCLAW_TSDOWN_MAX_OLD_SPACE_MB="${OPENCLAW_DOCKER_BUILD_TSDOWN_MAX_OLD_SPACE_MB}" \
    OPENCLAW_RUN_NODE_SKIP_DTS_BUILD=1 pnpm_config_verify_deps_before_run=false \
    pnpm build:docker \
    && pnpm_config_verify_deps_before_run=false pnpm ui:build

FROM openclaw-dependency-inputs AS openclaw-production-deps
# Build asset hooks need all plugin dependencies; the shipped runtime keeps only
# the selected plugins and the upstream required bundled dependencies.
RUN --mount=type=bind,from=matrix-sdk-crypto,source=/out,target=/tmp/matrix-sdk-crypto \
    --mount=type=bind,from=oce-source,source=/oce/deploy/runtime,target=/tmp/oce-runtime \
    set -eu; \
    set -- --filter . --filter ./ui --filter './packages/*'; \
    while IFS= read -r plugin; do \
      set -- "$@" --filter "./extensions/$plugin"; \
    done < openclaw-workspace-plugin-dirs; \
    sh /tmp/oce-runtime/install-attempts.sh \
        node /tmp/oce-runtime/with-pinned-matrix-sdk-crypto.mjs /tmp/matrix-sdk-crypto \
        pnpm install --frozen-lockfile --prod "$@" --store-dir=/tmp/pnpm-store \
        --config.supportedArchitectures.os=linux \
        --config.supportedArchitectures.cpu="$(node -p 'process.arch')" \
        --config.supportedArchitectures.libc=glibc \
    && node scripts/docker/verify-fs-safe-native.mjs --package-root /source --mode require \
    && rm -rf /tmp/pnpm-store

FROM openclaw-build AS openclaw-build-output
RUN rm -rf node_modules ui/node_modules \
    && find packages extensions -name node_modules -prune -exec rm -rf {} +

FROM openclaw-production-deps AS openclaw-runtime-assets
COPY --from=openclaw-build-output /source/ ./
# Keep lib/ a separate COPY: a multi-source COPY flattens every file to its
# basename, and build-runtime-assets.mjs imports ./lib/openclaw-source.mjs.
COPY --from=openclaw-source /tmp/oce/build-runtime-assets.mjs /tmp/oce/openclaw-source.json /tmp/oce/
COPY --from=openclaw-source /tmp/oce/lib/openclaw-source.mjs /tmp/oce/lib/
RUN /bin/bash -euo pipefail <<'EOF'
node scripts/postinstall-bundled-plugins.mjs
OPENCLAW_EXTENSIONS=codex,slack node scripts/prune-docker-plugin-dist.mjs
find dist -type f \( -name '*.d.ts' -o -name '*.d.mts' -o -name '*.d.cts' -o -name '*.map' \) -delete
if [ -L node_modules/@openclaw/ai ]; then
    target="$(readlink -f node_modules/@openclaw/ai)"
    temporary="$(mktemp -d)"
    cp -a "$target" "$temporary/ai"
    rm node_modules/@openclaw/ai
    mv "$temporary/ai" node_modules/@openclaw/ai
    rmdir "$temporary"
fi
rm -rf node_modules/openclaw node_modules/.bin/openclaw node_modules/.pnpm/openclaw@*/node_modules/openclaw
# The sealed recovery entries inline fs-safe's relative helper lookup.
cp node_modules/@openclaw/fs-safe/dist/windows-security-helper.exe dist/windows-security-helper.exe
node scripts/check-package-dist-imports.mjs /source
node scripts/docker/verify-fs-safe-native.mjs --package-root /source --mode require
EOF
# Bundled plugin chunks also live directly under dist and resolve dependencies
# from the package root. Link missing names there without replacing core versions.
RUN node --input-type=module <<'NODE'
import { existsSync, mkdirSync, readFileSync, realpathSync, symlinkSync } from "node:fs";
import { dirname, relative, resolve } from "node:path";
for (const plugin of ["codex", "slack"]) {
  const root = resolve("dist/extensions", plugin);
  const manifest = JSON.parse(readFileSync(resolve(root, "package.json"), "utf8"));
  for (const name of Object.keys(manifest.dependencies ?? {})) {
    const destination = resolve("node_modules", name);
    if (existsSync(destination)) continue;
    const source = realpathSync(resolve(root, "node_modules", name));
    mkdirSync(dirname(destination), { recursive: true });
    symlinkSync(relative(dirname(destination), source), destination);
  }
}
NODE
RUN --mount=type=bind,from=openclaw-source,source=/source/scripts,target=/verification/scripts \
    --mount=type=bind,from=openclaw-build,source=/source/node_modules,target=/verification/node_modules \
    --mount=type=bind,from=openclaw-bridge-tests,target=/verification/bridge-tests \
    node scripts/docker/copy-bootstrap-scripts.mjs /tmp/openclaw-runtime-bootstrap \
    && rm -rf scripts \
    && mv /tmp/openclaw-runtime-bootstrap/scripts scripts \
    && node /tmp/oce/build-runtime-assets.mjs package /source /out /tmp/oce/openclaw-source.json \
    && node /verification/scripts/check-package-dist-imports.mjs /source

FROM ${BASE_IMAGE}
USER 0

ARG BASE_IMAGE
ARG BUILDER_IMAGE
ARG OCE_COMMIT
ARG OPENCLAW_COMMIT
ARG OPENAI_CODEX_VERSION
ARG VARIANT=oce-runtime
ARG NAME=agentic-oce-runtime
ARG SUMMARY="Red Hat AI Agentic OpenClaw Enterprise Runtime Image"

LABEL io.openshell.sandbox.harness="${VARIANT}" \
      io.openshell.harness.version="${OPENCLAW_COMMIT}" \
      io.openshell.hummingbird.runtime-image="${BASE_IMAGE}" \
      io.openshell.hummingbird.builder-image="${BUILDER_IMAGE}" \
      org.openclaw.image.revision="${OPENCLAW_COMMIT}" \
      org.opencontainers.image.revision="${OCE_COMMIT}" \
      name="${NAME}" \
      com.redhat.component="${NAME}-container" \
      summary="${SUMMARY}" \
      description="${SUMMARY} with OpenClaw ${OPENCLAW_COMMIT} and Codex ${OPENAI_CODEX_VERSION}" \
      io.k8s.display-name="${SUMMARY}" \
      io.k8s.description="${SUMMARY}" \
      io.openshift.tags="hummingbird openclaw openclaw-enterprise ${NAME}" \
      distribution-scope="authoritative-source-only"

ENV OPENAI_CODEX_VERSION=${OPENAI_CODEX_VERSION}
# Hummingbird sets HOME=/tmp; OCE expects the node user's home.
ENV HOME=/home/node
ENV NODE_ENV=production
ENV NPM_CONFIG_UPDATE_NOTIFIER=false
ENV PATH=/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /app

RUN node -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); if (major !== 24 || minor < 22 || (minor === 22 && patch < 1)) throw new Error(`Select a Node.js 24.22.1+ base image in the 24 series; found ${process.version}.`);'

# Runtime tools OCE expects (Debian upstream: git, ca-certificates, curl,
# openssh-client, libstdc++6, libgomp1, python3, procps). The Hummingbird base
# already carries libstdc++ and ca-certificates-bundle. Debian's base image also
# provides flock, tar and gzip: OCE's workspace setup runs /usr/bin/flock, and
# OpenClaw's directory fetch (skill installs into node-backed workspaces) runs
# /usr/bin/tar -czf. util-linux-core, installed for flock, also ships setuid-root
# mount and umount; nothing here mounts, so clear every setuid and setgid bit the
# install adds. Non-hermetic: resolved from the builder's Hummingbird repositories
# without a lockfile; dnf is not retained.
RUN --mount=type=bind,from=builder,target=/builder /bin/bash -euo pipefail <<'EOF'
builder_tool() {
    local tool=$1
    shift
    LD_LIBRARY_PATH=/builder/lib64:/builder/usr/lib64 RPM_CONFIGDIR=/builder/usr/lib/rpm \
        "/builder/usr/bin/${tool}" "$@" < /dev/null
}
# Hummingbird's Node.js loads full ICU data from nodejs24-full-i18n; without it
# Intl.Segmenter crashes Node, and OpenClaw's Slack formatting segments reply text.
# The package requires the base image's exact nodejs24 build, so install that EVR
# instead of letting dnf upgrade Node off the pinned base.
node_evr="$(builder_tool rpm --root=/ -q --qf '%{EVR}' nodejs24)" ||
    {
        echo "nodejs24 is not installed in the base image" >&2
        exit 1
    }
builder_tool dnf install -y \
    --installroot=/ \
    --setopt=reposdir=/builder/etc/yum.repos.d \
    --setopt=install_weak_deps=False \
    --setopt=tsflags=nodocs \
    git-core curl openssh-clients libgomp python3 procps-ng tar gzip util-linux-core \
    "nodejs24-full-i18n-${node_evr}"
installed_evr="$(builder_tool rpm --root=/ -q --qf '%{EVR}' nodejs24)"
[[ ${installed_evr} == "${node_evr}" ]] ||
    {
        echo "dnf moved nodejs24 from ${node_evr} to ${installed_evr}" >&2
        exit 1
    }
node -e 'if ([...new Intl.Segmenter("en", {granularity: "grapheme"}).segment("\u{1F469}\u{1F3FD}\u200D\u{1F4BB}")].length !== 1) throw new Error("Intl.Segmenter needs nodejs24-full-i18n");'
rm -rf /var/cache/dnf /var/cache/yum /var/cache/libdnf5 /var/log/dnf5.log /run/dnf
find / -xdev -path /builder -prune -o -type f -perm /6000 -exec chmod ug-s {} +
EOF

COPY --from=tini-build /out/ /
COPY --from=gh-download /out/ /

# OCE runs agents as node (1000:1000) with HOME=/home/node and invokes
# /usr/local/bin/node directly; Hummingbird installs Node.js under /usr.
# Hard-link it rather than symlink it: OCE pins /usr/local/bin/node in its
# workspace-node-enrollment network policy, and OpenShell matches policies
# against the resolved executable path.
RUN /bin/bash -euo pipefail <<'EOF'
echo 'node:x:1000:1000:node:/home/node:/bin/bash' >> /etc/passwd
echo 'node:x:1000:' >> /etc/group
install -d -o node -g node -m 755 /home/node
ln "$(readlink -f "$(command -v node)")" /usr/local/bin/node
test "$(/usr/local/bin/node -p 'require("fs").readlinkSync("/proc/self/exe")')" = /usr/local/bin/node
/usr/local/bin/node --version
/usr/bin/tini --version
/usr/bin/git --version
# README.md tells operators to name this path in policies; fail the build when Python moves.
test "$(readlink -f /usr/bin/python3)" = /usr/bin/python3.14
# gh writes a random device ID under its state directory; keep it out of the image.
gh_state="$(mktemp -d)"
XDG_STATE_HOME="$gh_state" /usr/local/bin/gh --version | grep -q '^gh version '
rm -rf "$gh_state"
EOF

COPY --from=google-cli /out/ /

COPY --from=openclaw-runtime-assets /out/ /opt/oce/runtime/
COPY --from=openclaw-runtime-assets /source/ /app/node_modules/openclaw/
# Both gateway plugins and the Dedicated Harness resolve the same pinned Codex.
RUN mkdir -p node_modules/.bin \
    && ln -s openclaw/node_modules/ws node_modules/ws \
    && ln -s ../openclaw/openclaw.mjs node_modules/.bin/openclaw \
    && ln -s ../openclaw/node_modules/@openai/codex/bin/codex.js node_modules/.bin/codex

COPY --from=openclaw-runtime-assets /tmp/oce/build-runtime-assets.mjs /tmp/build-runtime-assets.mjs
COPY --from=openclaw-runtime-assets /tmp/oce/lib/openclaw-source.mjs /tmp/lib/openclaw-source.mjs
RUN /bin/bash -euo pipefail <<'EOF'
mkdir -p node_modules/openclaw/dist/extensions ./plugin-skills /etc/openclaw /home/node/.codex/generated_images
chown node:node /home/node/.codex /home/node/.codex/generated_images
chmod 700 /home/node/.codex /home/node/.codex/generated_images
cp -R node_modules/openclaw/dist/extensions/slack/skills/. ./plugin-skills/
ln -s node_modules/openclaw/openclaw.mjs ./openclaw.mjs
ln -s node_modules/openclaw/dist ./dist
cp -R node_modules/openclaw/skills ./skills
find /app -type d ! -perm -0555 -exec chmod a+rx {} +
find /app -type f ! -perm -0444 -exec chmod a+r {} +
find /app -type f -perm /0111 ! -perm -0111 -exec chmod a+x {} +
test -L /app/dist
test -d /app/skills
test ! -L /app/skills
test -d /app/plugin-skills/slack
test -f /app/plugin-skills/block-kit/references/official-block-kit.md
test "$(stat -c '%U:%G:%a' /home/node/.codex)" = "node:node:700"
test "$(stat -c '%U:%G:%a' /home/node/.codex/generated_images)" = "node:node:700"
node /app/openclaw.mjs --version
node -e 'if (typeof require("ws") !== "function") throw new Error("Runtime WebSocket dependency unavailable")'
(cd /app/node_modules/openclaw && node --input-type=module -e 'import { isSupported } from "@openclaw/proc-safe/reaper"; if (!isSupported()) throw new Error("Runtime native child reaping unavailable; install the locked proc-safe platform package")')
# Codex writes a randomly named arg0 directory under CODEX_HOME; keep it out of the image.
codex_home="$(mktemp -d)"
test "$(CODEX_HOME="$codex_home" codex --version)" = "codex-cli ${OPENAI_CODEX_VERSION}"
rm -rf "$codex_home"
test -f /app/dist/extensions/codex/openclaw.plugin.json
test -f /app/dist/extensions/slack/openclaw.plugin.json
node /tmp/build-runtime-assets.mjs inventory /app/node_modules/openclaw /opt/oce/runtime
rm /tmp/build-runtime-assets.mjs /tmp/lib/openclaw-source.mjs
EOF

RUN /usr/bin/git config --system --add include.path /run/oce/repository-credentials/gitconfig

RUN node -e 'const fs = require("node:fs"); const provenance = JSON.parse(fs.readFileSync("/opt/oce/runtime/provenance.json", "utf8")); if (!/^[a-f0-9]{40}$/.test(process.argv[1]) || provenance.commit !== process.argv[1]) throw new Error("OpenClaw label must match packaged provenance");' "${OPENCLAW_COMMIT}" \
    && node -e 'const fs = require("node:fs"); const revision = process.argv[1]; if (!/^[a-f0-9]{40}$/.test(revision)) throw new Error("Invalid OCE build revision"); fs.writeFileSync("/opt/oce/runtime/build.json", JSON.stringify({commit: revision}));' "${OCE_COMMIT}"

# Keep this last: a client change then rebuilds only this layer.
COPY --from=repository-client-build /oce/.build/runtime-client/ /

USER node
