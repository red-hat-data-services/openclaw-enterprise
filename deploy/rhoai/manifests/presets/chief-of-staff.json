{
  "name": "Chief of Staff",
  "template": {
    "variables": {
      "name": {
        "type": "string",
        "description": "Name for the new Agent"
      },
      "model": {
        "type": "string",
        "description": "Codex model ID without the codex/ prefix"
      },
      "modelSecret": {
        "type": "password",
        "description": "Model API key; stored as a Secret when you create the Agent"
      }
    },
    "agent": {
      "name": "{{ vars.name }}",
      "executionMode": "dedicated",
      "backendId": null,
      "harnessAuth": {
        "method": "api_key",
        "secret": "{{ vars.modelSecret }}"
      },
      "plugins": {},
      "initialWorkspaceFiles": {
        "AGENTS.md": "# Chief of Staff\n\nYou are {{ vars.name }}.\n\nHelp the user prioritize work, prepare decisions, coordinate follow-through, and communicate clearly. Turn available notes and discussions into concise briefings, agendas, action lists, and decision records. Track owners, deadlines, dependencies, and unresolved questions when sources supply them; mark missing information rather than inventing it. Distinguish confirmed commitments from suggestions. Explain tradeoffs and recommend next steps. Draft messages for review; send messages, modify calendars, or make commitments only when explicitly authorized. Use only available, authorized sources and do not imply access to email, calendars, or other systems that are not connected.\n"
      }
    },
    "configuration": {
      "values": {
        "gateway": {
          "mode": "local",
          "bind": "lan",
          "controlUi": {
            "enabled": true
          },
          "auth": {
            "password": {
              "source": "env",
              "provider": "default",
              "id": "OPENCLAW_GATEWAY_PASSWORD"
            }
          }
        },
        "agents": {
          "defaults": {
            "model": "codex/{{ vars.model }}",
            "models": {
              "codex/{{ vars.model }}": {
                "agentRuntime": {
                  "id": "codex"
                }
              }
            }
          }
        },
        "models": {
          "providers": {
            "codex": {
              "baseUrl": "http://127.0.0.1:9",
              "api": "openai-responses",
              "models": [
                {
                  "id": "{{ vars.model }}",
                  "name": "{{ vars.model }}"
                }
              ]
            }
          }
        },
        "browser": {
          "enabled": false
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "web": {
            "search": {
              "enabled": true,
              "openaiCodex": {
                "enabled": true,
                "mode": "cached"
              }
            },
            "fetch": {
              "enabled": false
            }
          }
        },
        "plugins": {
          "allow": [
            "codex"
          ],
          "entries": {
            "codex": {
              "enabled": true,
              "config": {
                "appServer": {
                  "mode": "guardian",
                  "transport": "websocket",
                  "url": "${APP_SERVER_URL}",
                  "authToken": "${APP_SERVER_TOKEN}",
                  "approvalPolicy": "on-request",
                  "sandbox": "read-only",
                  "networkProxy": {
                    "enabled": true,
                    "baseProfile": "workspace",
                    "mode": "limited",
                    "domains": {
                      "codeload.github.com": "allow",
                      "dl.google.com": "allow",
                      "github.com": "allow",
                      "go.dev": "allow",
                      "nodejs.org": "allow",
                      "proxy.golang.org": "allow",
                      "registry.npmjs.org": "allow",
                      "storage.googleapis.com": "allow",
                      "sum.golang.org": "allow"
                    },
                    "unixSockets": {},
                    "enableSocks5": false,
                    "enableSocks5Udp": false,
                    "allowUpstreamProxy": false,
                    "allowLocalBinding": false,
                    "dangerouslyAllowNonLoopbackProxy": false,
                    "dangerouslyAllowAllUnixSockets": false
                  },
                  "approvalsReviewer": "user"
                }
              }
            }
          }
        }
      },
      "secretBindings": {}
    }
  }
}
