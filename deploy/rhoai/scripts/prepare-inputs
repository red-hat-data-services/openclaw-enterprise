#!/usr/bin/env bash
# Prepare private inputs for the IPv4 OpenShift test profile; never apply resources.
# Usage: prepare-inputs [bootstrap|refresh]
set -euo pipefail
umask 077

mode=${1:-bootstrap}
case "$mode" in
  bootstrap|refresh) ;;
  *) echo 'Usage: prepare-inputs [bootstrap|refresh]' >&2; exit 1 ;;
esac

: "${OCC_INPUT_DIRECTORY:?Set the existing private input directory}"

: "${OCE_CHECKOUT:?Set the OCE source checkout}"
OCE_CHECKOUT=$(cd "$OCE_CHECKOUT" && pwd -P)
repository=$(cd "$(dirname "$0")/.." && pwd -P)
export OCC_INPUT_DIRECTORY
OCC_INPUT_DIRECTORY=$(cd "$OCC_INPUT_DIRECTORY" && pwd -P)
case "$OCC_INPUT_DIRECTORY/" in
  "$repository/"*|"$OCE_CHECKOUT/"*) echo 'Keep deployment inputs outside the checkout.' >&2; exit 1 ;;
esac

if [[ "$mode" == bootstrap ]]; then
  : "${OCC_CONSOLE_HOST:?Set the Console Route hostname}"
  : "${OCC_ADMIN_EMAIL:?Set the bootstrap administrator email}"
  : "${CONTROLLER_IMAGE:?Set the controller image digest}"
  : "${RUNTIME_IMAGE:?Set the runtime image digest}"
  [[ "$CONTROLLER_IMAGE" =~ @sha256:[a-f0-9]{64}$ ]]
  [[ "$RUNTIME_IMAGE" =~ @sha256:[a-f0-9]{64}$ ]]
fi

export OCC_CLUSTER_NAME
OCC_CLUSTER_NAME=$(oc get infrastructure.config.openshift.io cluster -o jsonpath='{.status.infrastructureName}')
export PG_POD_CIDR
PG_POD_CIDR=$(oc -n openclaw-postgres get pods \
  -l postgres-operator.crunchydata.com/cluster=oce-postgres,postgres-operator.crunchydata.com/role=master -o json |
  jq -er '.items | if length != 1 then error("expected one PostgreSQL primary") else
    .[0].status.podIP | if type == "string" and (contains(":") | not) then . + "/32"
    else error("expected an IPv4 PostgreSQL primary address") end end')
export API_SERVICE_CIDR
API_SERVICE_CIDR=$(oc -n default get service kubernetes -o json |
  jq -er '.spec.clusterIP | if type == "string" and . != "None" and (contains(":") | not)
    then . + "/32" else error("expected an IPv4 Kubernetes API Service") end')
oc -n default get endpointslices -l kubernetes.io/service-name=kubernetes -o json |
  jq -e '[.items[].endpoints[].addresses[]] | unique |
    if length > 0 and all(contains(":") | not) then map(. + "/32")
    else error("expected IPv4 Kubernetes API endpoints") end' > "$OCC_INPUT_DIRECTORY/api-cidrs.json"
oc -n default get endpointslices -l kubernetes.io/service-name=kubernetes -o json |
  jq -e '[.items[].ports[] | select(.protocol == "TCP") | .port] | unique |
    if length > 0 and all(type == "number") then map({protocol:"TCP", port:.})
    else error("expected Kubernetes API TCP ports") end' > "$OCC_INPUT_DIRECTORY/api-ports.json"
oc -n openshift-ingress get pods \
  -l ingresscontroller.operator.openshift.io/deployment-ingresscontroller=default -o json |
  jq -e '[.items[].status.podIP] | unique |
    if length > 0 and all(type == "string" and (contains(":") | not)) then map(. + "/32")
    else error("expected IPv4 router Pod addresses") end' > "$OCC_INPUT_DIRECTORY/router-cidrs.json"

for name in values installation; do
  if [[ ! -e "$OCC_INPUT_DIRECTORY/$name.yaml" ]]; then
    if [[ "$mode" == refresh ]]; then
      echo "Missing $name.yaml; run prepare-inputs bootstrap first." >&2
      exit 1
    fi
    install -m 600 "$OCE_CHECKOUT/deploy/examples/production/$name.yaml" "$OCC_INPUT_DIRECTORY/$name.yaml"
  fi
done
if [[ ! -e "$OCC_INPUT_DIRECTORY/bootstrap-pvc.yaml" ]]; then
  install -m 600 "$repository/manifests/openshift/base/control-plane/bootstrap-pvc.yaml" "$OCC_INPUT_DIRECTORY/bootstrap-pvc.yaml"
fi
for name in control-plane-postgres-egress control-plane-kube-api-egress; do
  if [[ ! -e "$OCC_INPUT_DIRECTORY/$name.yaml" ]]; then
    install -m 600 "$repository/manifests/openshift/base/control-plane/$name.yaml" "$OCC_INPUT_DIRECTORY/$name.yaml"
  fi
done

if [[ "$mode" == bootstrap ]]; then
  yq -i '.images.controller = strenv(CONTROLLER_IMAGE) |
    .auth.baseUrl = "https://" + strenv(OCC_CONSOLE_HOST) |
    .bootstrap.adminEmail = strenv(OCC_ADMIN_EMAIL) |
    .database.caSecretName = "occ-database-ca" |
    .database.cidrs = [strenv(PG_POD_CIDR)] |
    .api.clients = [{"namespace":"openshift-ingress","podLabels":{
      "ingresscontroller.operator.openshift.io/deployment-ingresscontroller":"default"}}] |
    .api.trustedProxy = {"preset":"generic",
      "cidrs":load(strenv(OCC_INPUT_DIRECTORY) + "/router-cidrs.json"),
      "clientAddressHeader":"x-forwarded-for"} |
    .cluster.cidrs = [strenv(API_SERVICE_CIDR)] + load(strenv(OCC_INPUT_DIRECTORY) + "/api-cidrs.json") |
    .controlPlane.nodeSelector = {"oce-role":"control"} |
    .dns = {"namespace":"openshift-dns","podLabels":{
      "dns.operator.openshift.io/daemonset-dns":"default","k8s-app":null}}' \
    "$OCC_INPUT_DIRECTORY/values.yaml"
  yq -i '.occ.cluster = strenv(OCC_CLUSTER_NAME) |
    .drivers.compute.configuration.images.gateway = strenv(RUNTIME_IMAGE) |
    .drivers.compute.configuration.images.agent = strenv(RUNTIME_IMAGE) |
    .drivers.compute.configuration.network.dns = {"namespace":"openshift-dns",
      "podLabels":{"dns.operator.openshift.io/daemonset-dns":"default"}} |
    .drivers.compute.configuration.runtime.gatewayStorageClassName = "gp3-csi" |
    .drivers.compute.configuration.runtime.nodeSelector = {"oce-role":"agent"} |
    .drivers.compute.configuration.runtime.gatewayNodeSelector = {"oce-role":"control"}' \
    "$OCC_INPUT_DIRECTORY/installation.yaml"
  # Initial install keeps the launcher off until private routing and admin HTTPS are ready.
  # Configure it after Agent deployment; an OAuth Route alone is insufficient.
  # See deploy/rhoai/README.md#other-profiles.
  yq -i '.agentNativeAdmin.enabled = false |
    .agentNativeAdmin.domain = "" | .agentNativeAdmin.sharedCookieDomain = "" |
    .gatewayRouting.enabled = false' "$OCC_INPUT_DIRECTORY/values.yaml"
  yq -i '.drivers.compute.configuration.network.gatewayTrustedProxyCidrs = ["127.0.0.1/32"] |
    .drivers.compute.configuration.network.gatewayClients = [{"namespace":"openclaw-system","podLabels":{
      "app.kubernetes.io/name":"openclaw-enterprise","app.kubernetes.io/instance":"oce","app.kubernetes.io/component":"api"}}] |
    del(.drivers.compute.configuration.gatewayRouting)' \
    "$OCC_INPUT_DIRECTORY/installation.yaml"
  yq -i '.spec.storageClassName = "gp3-csi"' "$OCC_INPUT_DIRECTORY/bootstrap-pvc.yaml"
else
  if ! yq -e '.api.trustedProxy' "$OCC_INPUT_DIRECTORY/values.yaml" >/dev/null; then
    echo 'Missing api.trustedProxy in values.yaml; run prepare-inputs bootstrap first.' >&2
    exit 1
  fi
  # Refresh only discovered addresses; keep approved API clients and the
  # configured proxy preset and header.
  yq -i '.database.cidrs = [strenv(PG_POD_CIDR)] |
    .api.trustedProxy.cidrs = load(strenv(OCC_INPUT_DIRECTORY) + "/router-cidrs.json") |
    .cluster.cidrs = [strenv(API_SERVICE_CIDR)] + load(strenv(OCC_INPUT_DIRECTORY) + "/api-cidrs.json")' \
    "$OCC_INPUT_DIRECTORY/values.yaml"
fi

yq -i '.spec.egress[0].to = (load(strenv(OCC_INPUT_DIRECTORY) + "/api-cidrs.json") | map({"ipBlock":{"cidr":.}})) |
  .spec.egress[0].ports = load(strenv(OCC_INPUT_DIRECTORY) + "/api-ports.json")' \
  "$OCC_INPUT_DIRECTORY/control-plane-kube-api-egress.yaml"

if [[ "$mode" == refresh ]]; then
  checksum=$(sha256sum "$OCC_INPUT_DIRECTORY/installation.yaml" | cut -d ' ' -f 1)
  yq -i ".controlPlane.installationChecksum = \"$checksum\"" "$OCC_INPUT_DIRECTORY/values.yaml"
  printf 'Refreshed discovered addresses and egress inputs; routing, API clients, trusted-proxy preset, and admin-launcher settings were preserved.\n'
else
  printf 'Prepared private Helm, Installation, bootstrap PVC, and egress policy inputs.\n'
  printf 'The OCC admin launcher starts disabled; configure it after deploying the Agent.\n'
fi
printf 'No cluster resources were changed.\n'
printf 'See deploy/rhoai/README.md#other-profiles.\n'
