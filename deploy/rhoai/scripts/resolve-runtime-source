#!/usr/bin/env python3
"""Read runtime source metadata from a frozen OCE revision; change nothing."""
import datetime
import json
import re
import subprocess
import sys

if len(sys.argv) != 3 or not re.fullmatch(r"[a-f0-9]{40}", sys.argv[2]):
    sys.exit("Usage: resolve-runtime-source OCE_CHECKOUT FULL_OCE_COMMIT")
checkout, revision = sys.argv[1:]


def git(*args):
    return subprocess.check_output(["git", "-C", checkout, *args], text=True)


try:
    path = "deploy/runtime/openclaw-source.json"
    if git("ls-tree", "--name-only", revision, "--", path).strip():
        source = json.loads(git("show", f"{revision}:{path}"))
    else:
        # Releases before OCE #3776 keep these values in the runtime Dockerfile.
        dockerfile = git("show", f"{revision}:deploy/runtime/Dockerfile")
        source = {}
        for key, pattern in {
            "commit": r"^ARG OPENCLAW_COMMIT=([a-f0-9]{40})$",
            "sourceArchiveSha256": r"([a-f0-9]{64})  /tmp/openclaw-source\.tar\.gz",
            "buildTimestamp": r"^ENV OPENCLAW_BUILD_TIMESTAMP=(\S+)$",
        }.items():
            match = re.search(pattern, dockerfile, re.MULTILINE)
            if not match:
                raise ValueError(f"runtime Dockerfile has no {key}")
            source[key] = match[1]
    if not isinstance(source, dict) or set(source) != {
        "commit", "sourceArchiveSha256", "buildTimestamp"
    }:
        raise ValueError("source manifest must contain commit, sourceArchiveSha256, and buildTimestamp")
    for key, pattern in {
        "commit": r"[a-f0-9]{40}",
        "sourceArchiveSha256": r"[a-f0-9]{64}",
        "buildTimestamp": r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z",
    }.items():
        if not isinstance(source[key], str) or not re.fullmatch(pattern, source[key]):
            raise ValueError(f"invalid {key} in runtime source metadata")
    datetime.datetime.strptime(source["buildTimestamp"], "%Y-%m-%dT%H:%M:%SZ")
except (ValueError, subprocess.CalledProcessError) as error:
    sys.exit(f"Cannot resolve runtime source at OCE {revision}: {error}")

print(json.dumps({
    "oceCommit": revision,
    "openclawCommit": source["commit"],
    "sourceArchiveSha256": source["sourceArchiveSha256"],
    "openclawBuildTimestamp": source["buildTimestamp"],
}, indent=2))
